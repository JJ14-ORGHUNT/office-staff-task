# Copy to .env for local use. On Vercel/Render set these in the dashboard.

# Postgres connection string (Supabase / Neon / any Postgres).
# Leave empty locally to use a SQLite file at ./data/app.db instead.
DATABASE_URL=

# Long random string used to sign login cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Office time zone - decides when "today" starts and ends.
APP_TZ=Asia/Kolkata

# PIN for the ADMIN account created on first run (only used once, when the DB is empty).
ADMIN_PIN=admin123

PORT=3000
